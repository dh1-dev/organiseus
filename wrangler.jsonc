{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "organiseus",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/vendor/*"
    ]
  }
}